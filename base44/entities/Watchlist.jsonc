{
  "name": "Watchlist",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Verified Firebase uid \u2014 set server-side only"
    },
    "symbol": {
      "type": "string",
      "description": "Ticker symbol"
    },
    "name": {
      "type": "string",
      "description": "Company name"
    },
    "sector": {
      "type": "string",
      "description": "Industry sector"
    },
    "alert_price": {
      "type": "number",
      "description": "Price alert threshold"
    },
    "notes": {
      "type": "string",
      "description": "User notes about this asset"
    }
  },
  "required": [
    "symbol",
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}