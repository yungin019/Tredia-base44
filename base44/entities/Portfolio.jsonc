{
  "name": "Portfolio",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Verified Firebase uid \u2014 set server-side only"
    },
    "symbol": {
      "type": "string",
      "description": "Ticker symbol"
    },
    "name": {
      "type": "string",
      "description": "Company name"
    },
    "shares": {
      "type": "number",
      "description": "Number of shares held"
    },
    "avg_cost": {
      "type": "number",
      "description": "Average cost per share"
    },
    "current_price": {
      "type": "number",
      "description": "Current price per share"
    },
    "sector": {
      "type": "string",
      "description": "Industry sector"
    }
  },
  "required": [
    "symbol",
    "name",
    "shares",
    "avg_cost"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}