{
  "name": "NotificationLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Verified Firebase uid \u2014 set server-side only"
    },
    "date": {
      "type": "string",
      "description": "Date string YYYY-MM-DD"
    },
    "count": {
      "type": "number",
      "description": "Number of notifications sent today",
      "default": 0
    },
    "signal_type": {
      "type": "string",
      "description": "Last signal type sent"
    },
    "symbol": {
      "type": "string",
      "description": "Asset symbol"
    }
  },
  "required": [
    "user_id",
    "date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}