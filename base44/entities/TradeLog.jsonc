{
  "name": "TradeLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Verified Firebase uid \u2014 set server-side only"
    },
    "symbol": {
      "type": "string",
      "description": "Ticker symbol"
    },
    "name": {
      "type": "string",
      "description": "Company name"
    },
    "action": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ],
      "description": "Trade action"
    },
    "shares": {
      "type": "number",
      "description": "Number of shares"
    },
    "price": {
      "type": "number",
      "description": "Price per share at execution"
    },
    "total": {
      "type": "number",
      "description": "Total trade value"
    },
    "status": {
      "type": "string",
      "enum": [
        "executed",
        "pending",
        "cancelled"
      ],
      "default": "executed"
    }
  },
  "required": [
    "symbol",
    "action",
    "shares",
    "price"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}